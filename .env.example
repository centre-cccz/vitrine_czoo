# .env.example — configuration example for CCC Le Zoo
# Never commit the real .env file. On cPanel, place it one directory above DOCUMENT_ROOT
# (for example, beside public_html) so it is outside the public webroot.

# Application environment: development|staging|production
APP_ENV=development
APP_URL=http://localhost

# Database
DB_HOST=127.0.0.1
DB_NAME=ccczoo
DB_USER=root
# Quote values that contain INI special characters such as # or ;
DB_PASS=
DB_CHARSET=utf8mb4

# Mail (example)
MAIL_FROM=contact@ccclezoo.cd
MAIL_HOST=localhost

# Absolute path outside the public webroot for confidential internal documents
INTERNAL_DOCUMENTS_PATH=

# Security
# It's recommended to use a secret manager for production instead of .env files.

# Fichier de repli du formulaire de contact (chemin absolu HORS racine web, optionnel)
CONTACT_LOG_PATH=
